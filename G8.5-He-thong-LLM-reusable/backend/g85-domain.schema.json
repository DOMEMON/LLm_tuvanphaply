{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G8.5 domain profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "language", "scope", "attributes", "capabilities", "ingestion", "retrieval", "limits"],
  "properties": {
    "schema_version": {"const": "g85-domain-v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "data_classification": {"enum": ["D0_SYSTEM_SMOKE", "D1_PUBLIC_DEMO", "D2_COMPANY_REAL"]},
    "policies": {"$ref": "#/$defs/strings"},
    "service_region_aliases": {"$ref": "#/$defs/strings"},
    "planner_instructions": {"$ref": "#/$defs/strings"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "included_topics", "excluded_requests", "service_regions", "evidence_policy"],
      "properties": {
        "description": {"type": "string", "minLength": 20},
        "included_topics": {"$ref": "#/$defs/nonemptyStrings"},
        "excluded_requests": {"$ref": "#/$defs/strings"},
        "service_regions": {"$ref": "#/$defs/strings"},
        "evidence_policy": {"const": "approved_sources_only"}
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "filterable": {"type": "boolean"}
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "checklist", "external_lookup", "actions"],
      "properties": {
        "catalog": {"type": "boolean"}, "checklist": {"type": "boolean"},
        "external_lookup": {"const": false}, "actions": {"const": false}
      }
    },
    "ingestion": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "require_review"],
      "properties": {
        "adapter": {"enum": ["administrative_release_v1", "documents_v1"]},
        "require_review": {"const": true}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_lookup", "document_search", "reranker"],
      "properties": {
        "exact_lookup": {"type": "boolean"},
        "document_search": {"enum": ["hybrid", "lexical"]},
        "reranker": {"enum": ["off", "on"]}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tasks", "max_plan_repairs", "max_search_rounds", "max_synthesis_calls", "top_k"],
      "properties": {
        "max_tasks": {"type": "integer", "minimum": 1, "maximum": 36},
        "max_plan_repairs": {"type": "integer", "minimum": 0, "maximum": 1},
        "max_search_rounds": {"type": "integer", "minimum": 1, "maximum": 2},
        "max_synthesis_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 12}
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonemptyStrings": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]}
  }
}
